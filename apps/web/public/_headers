# Cloudflare Workers static-asset headers. These files are served straight from
# the asset layer and never reach the Worker, so next.config headers() does not
# apply to them.

# Content-hashed build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Files in /public keep their name when replaced, so cache for a week and
# revalidate in the background.
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Collection tile photos are regenerated by sync:collection-images, not renamed.
/collections/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.avif
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.json
  Cache-Control: public, max-age=86400

# The service worker must always be revalidated so updates roll out.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
