# Growman backend configuration — TEMPLATE
#
# Copy to .env and fill in. Never commit real credentials here: this file is
# tracked in git, so anything placed in it is published to everyone with
# repository access and stays in the history even after it is removed.
#
# Values marked REQUIRED IN PRODUCTION are checked at startup by
# config.Load(); the service refuses to boot without them rather than
# failing later at checkout.

# ---- Core ----
GO_PORT=:8080
# development | test | production. Production enables the secret checks
# below and disables the non-production signature bypass.
GO_ENV=development
AUTO_MIGRATE=true
SEED_ON_STARTUP=false

# Postgres. Use HYPERDRIVE_URL instead when running behind Cloudflare
# Hyperdrive.
DATABASE_URL=postgresql://user:password@localhost:5432/growman?sslmode=disable
# HYPERDRIVE_URL=

# Signs every JWT. Use a long random string; changing it invalidates all
# existing sessions.
JWT_SECRET=change-me-to-a-long-random-string

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Optional. Without it the catalogue cache, rate limiter and OTP store all
# fall back to in-process memory, which is correct but not shared between
# replicas.
REDIS_URL=

# ---- Razorpay ----
# These are two DIFFERENT secrets and they are not interchangeable.
#
# RAZORPAY_KEY_SECRET is the API key secret from Settings -> API Keys. It
# signs the checkout callback: HMAC-SHA256 of "<order_id>|<payment_id>".
#
# RAZORPAY_WEBHOOK_SECRET is generated when you create the webhook under
# Settings -> Webhooks, and you choose its value there. It signs the raw
# webhook request body. Putting the key secret here makes every webhook
# delivery fail its signature check — silently, because the happy path
# still works through the callback. Watch
# payment_signature_failures_total{stage="webhook"} after any change.
RAZORPAY_KEY_ID=
# REQUIRED IN PRODUCTION
RAZORPAY_KEY_SECRET=
# REQUIRED IN PRODUCTION
RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---- Email (SMTP) ----
# For Gmail this must be an app password, not the account password.
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MERCHANT_NOTIFY_EMAIL=
# Ops alerts (signups, paid orders, checkout drop-offs, long browsing).
# When set, those alerts go here instead of MERCHANT_NOTIFY_EMAIL.
# A browsing alert is sent only for a real browser that stayed 10 minutes,
# and only after the IP is confirmed not to be a bot or a datacenter.
# The map coordinates in that alert are included in the Discord message only.
# Channel settings → Integrations → Webhooks → Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# Inboxes for customer enquiries.
QUOTATION_EMAIL=
WAITLIST_EMAIL=

# ---- Google OAuth ----
# Web client ID, shared with the mobile EXPO_PUBLIC_GOOGLE_CLIENT_ID and the
# web NEXT_PUBLIC_GOOGLE_CLIENT_ID. Used to verify the id_token from
# mobile/web sign-in.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Image storage ----
# Required: Base URL for image storage
IMAGE_BASE_URL=

# Azure Blob Storage (optional - set these if using Azure)
# AZURE_STORAGE_ACCOUNT_NAME=youraccount
# AZURE_STORAGE_ACCOUNT_KEY=your-key-here
# AZURE_STORAGE_CONTAINER_NAME=images

# Google Cloud Storage (optional - set these if using GCS)
# GCS_BUCKET_NAME=your-bucket
# GCS_PROJECT_ID=your-project-id
# GCS_CREDENTIALS_JSON=/path/to/service-account.json

# AI Chat Configuration
# OpenAI API key for chatbot functionality (get from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Read by the Python RAG service (apps/ai), not by this Go process.
GEMINI_API_KEY=
# AI Provider is unused for chat. Dootha answers come from the RAG service.
AI_PROVIDER=gemini

# Dootha RAG. Leave RAG_SERVICE_URL empty to keep the canned chat replies.
# The secret must match the Python service. The browser never sees it.
RAG_SERVICE_URL=
RAG_SHARED_SECRET=

# Pl@ntNet visual identification (https://my.plantnet.org).
# The free plan is 500 identifications per UTC day. Species, disease, and
# variety scans share that budget. Catalog reads are cached and do not
# spend an identify credit.
PLANTNET_API_KEY=
# Flora used when a scan has no lat/lon. "all" lets Pl@ntNet pick the
# closest Kew flora. Send lat and lon on the scan to prefer a regional k- project.
PLANTNET_PROJECT=all
# Identifications held back so species scans still work after health scans
# have been using the daily quota. Extra calls are skipped at or below this.
PLANTNET_RESERVE=40

# Optional: Truecaller one-tap (Android OAuth client id from https://developer.truecaller.com)
TRUECALLER_CLIENT_ID=
# MSG91 phone OTP
# Account Authkey (server) — used for verifyAccessToken
MSG91_AUTH_KEY=
# Widget credentials for default MSG91 SMS (no custom DLT template)
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
# Optional: only for legacy REST /auth/otp/send with your own DLT template
MSG91_TEMPLATE_ID=

# Fulfillment / delivery rules (internal/fulfillment)
# Store coordinates, used to measure the distance to each customer.
# Defaults to the Hyderabad city centre until set to the real nursery.
STORE_LATITUDE=
STORE_LONGITUDE=
# Store pickup pincode, sent to Shiprocket as the origin. Serviceability
# lookups are skipped entirely until this is set.
STORE_PINCODE=
# Courier aggregator name, recorded on each order.
COURIER_PROVIDER=Shiprocket
# Shiprocket issues no static API key. Create a dedicated API user in the
# Shiprocket panel (Settings -> API -> Configure -> Create an API User) on
# an email that is NOT your Shiprocket login, and put those credentials
# here. They are exchanged for a JWT valid 10 days, refreshed automatically.
# Do not use your dashboard login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Alternative to the password: paste a token from the auth API. Avoids
# storing a password, but Shiprocket tokens expire after 10 days and this
# one is not auto-renewed — set the credentials above instead if you do not
# want to rotate it by hand. If both are set, the token is used until
# rejected, then the credentials take over.
#
# This must be the JWT that POST /v1/external/auth/login returns: hundreds
# of characters, beginning "eyJ". An API key or secret copied from anywhere
# else in the Shiprocket panel will not authenticate and is ignored with a
# warning at startup.
SHIPROCKET_TOKEN=
# Pickup location nickname exactly as it appears in Shiprocket under
# Settings -> Pickup Addresses. Shiprocket rejects a booking whose pickup
# location does not match one of these by name.
SHIPROCKET_PICKUP_LOCATION=
# Shared secret for POST /webhooks/shiprocket, sent by Shiprocket in the
# x-api-key header and set under Settings -> API -> Webhooks. Leave blank
# and the endpoint refuses every request rather than trusting unsigned
# status updates.
SHIPROCKET_WEBHOOK_TOKEN=
#
# Either way the API is used only to check serviceability and read the rate
# Growman would be charged; the customer is always billed the zone fee
# bands. Leave all of this blank to skip the lookup and quote on fee bands
# alone.
# Subtotal above which the courier fee is waived. Leave at 0 to charge the
# real cost; set it (e.g. 999) only once the actual courier cost and gross
# margin per order are known.
FREE_DELIVERY_MIN_SUBTOTAL=0
# Furthest zone that gets self-serve delivery: store_local (10km), near
# (20km), mid (30km) or far (50km, the default). Beyond it, checkout offers
# only a store visit or a custom-delivery quote — no courier or vehicle fee.
RETAIL_MAX_ZONE=
# Minimum subtotal before the Growman vehicle is offered (default 2500).
OWN_VEHICLE_MIN_SUBTOTAL=
# Cart size/value at which checkout hands over to a sales quote
# (defaults: 10 plants, 15000 rupees).
BULK_MIN_UNITS=
BULK_MIN_SUBTOTAL=
