{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  // .open-next is OpenNext's build output. It is generated JavaScript that
  // we neither write nor review, and it does not satisfy our compiler
  // options, so type-checking it only produces noise.
  "exclude": ["node_modules", ".open-next", ".next"]
}
