# Copy to .env. This file is a template; do not put real secrets in it.
#
# The names match the Go service so one .env can describe both processes.
# PY_PORT defaults to 8081 so this API can run beside the Go server.

PY_PORT=8081
APP_ENV=development
AUTO_MIGRATE=true
SEED_ON_STARTUP=true

DATABASE_URL=postgresql://user:password@localhost:5432/growman?sslmode=disable
# HYPERDRIVE_URL=

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Optional. Without it the cache, rate limits, and OTP store stay in this process.
REDIS_URL=

# Two different secrets. The key secret signs checkout. The webhook secret signs Razorpay's callbacks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MERCHANT_NOTIFY_EMAIL=
DISCORD_WEBHOOK_URL=

GOOGLE_CLIENT_ID=
IMAGE_BASE_URL=
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CREDENTIALS_JSON=

# Admin map. World map is empty when these are unset; the India drill-down returns 502.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

RAG_SERVICE_URL=
RAG_SHARED_SECRET=

PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANTNET_RESERVE=40

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
TRUECALLER_CLIENT_ID=

STORE_LATITUDE=
STORE_LONGITUDE=
STORE_PINCODE=
COURIER_PROVIDER=Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_TOKEN=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
FREE_DELIVERY_MIN_SUBTOTAL=0
RETAIL_MAX_ZONE=
OWN_VEHICLE_MIN_SUBTOTAL=
BULK_MIN_UNITS=
BULK_MIN_SUBTOTAL=

DB_MAX_OPEN_CONNS=40
REDIS_POOL_SIZE=20
