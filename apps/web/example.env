# Growman web configuration — TEMPLATE
#
# Copy to .env.local and fill in. Never commit real credentials here: this
# file is tracked in git, so anything placed in it is published to everyone
# with repository access and stays in the history even after it is removed.
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is
# server-only, and a secret must never be given a NEXT_PUBLIC_ prefix —
# that inlines it into the client bundle.

# Where the Go backend lives. NEXT_PUBLIC_GO_API_URL takes precedence over
# NEXT_PUBLIC_API_URL; set one of them in production or the app falls back
# to localhost and every request fails CORS.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_GO_API_URL=https://your-backend.example.com/api/v1

# Razorpay publishable key id, used to open the checkout widget. The key
# *secret* belongs only in the backend's environment — it signs payment
# verification and must never be exposed to the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google OAuth web client ID. Must match the backend's GOOGLE_CLIENT_ID,
# which verifies the id_token this produces.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
