{
  // Worker identity
  "name": "growman-web",
  // Custom entry that wraps .open-next/worker.js and edge-caches /_next/image
  "main": "worker.ts",
  "compatibility_date": "2025-12-17",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (OpenNext)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Custom domain routing
  "routes": [
    {
      "pattern": "growman.live",
      "custom_domain": true
    }
  ],

  // Observability / logging
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },


  // Workers Analytics Engine
  "analytics_engine_datasets": [
    { "binding": "WAE", "dataset": "wae_events_v2" }
  ],

  // Cloudflare Images — powers next/image via OpenNext (/_next/image)
  "images": {
    "binding": "IMAGES"
  },

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7d1c239b89c04e70badd4d156d61e931"
    }
  ],

  // OpenNext incremental cache (see open-next.config.ts). Create once with:
  //   npx wrangler r2 bucket create growman-next-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "growman-next-cache"
    }
  ],

  // ISR revalidation queue. DOQueueHandler is re-exported from worker.ts.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ]
}